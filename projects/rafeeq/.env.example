# Copy to projects/rafeeq/.env and fill in locally. Never commit .env.
# The backend loads this file automatically. Exported environment variables take precedence.

# Required: OpenRouter API key (https://openrouter.ai/keys).
# Free model availability and quotas can change; check your provider dashboard.
OPENROUTER_API_KEY=

# Optional: a tool-calling model available on your OpenRouter account.
# The free router can choose different models across calls. Pin a model for final A/B evaluation.
RAFEEQ_MODEL=openrouter/free

# Set a long random token to enable the separate demo finance-officer endpoint.
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Do not use the AI API key here. Leave blank to disable officer decisions.
RAFEEQ_OFFICER_TOKEN=

# Conservative upper-bound USD per million tokens; verify against the chosen model's pricing.
# These values are budgeting assumptions, not a claim about the provider's actual prices.
RAFEEQ_INPUT_USD_PER_MILLION=1
RAFEEQ_OUTPUT_USD_PER_MILLION=3
RAFEEQ_MAX_COST_USD=0.50

# Optional: persistent local data directory. Default: projects/rafeeq/runtime
# RAFEEQ_RUNTIME=/absolute/path/to/private/runtime

# Hugging Face / custom endpoints are not used by this implementation.
# No HF_TOKEN or unrelated course configuration is required.
